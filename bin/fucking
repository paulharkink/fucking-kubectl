#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
fucking: escalated Kubernetes deletes for the current namespace.

Usage:
  fucking die POD
  fucking nope TYPE NAME

Options:
  -h, --help  Show this help.

Commands:
  die   Force-delete a pod immediately.
        Runs: kubectl delete pod POD --grace-period=0 --force

  nope  Force-delete any namespaced resource immediately.
        Runs: kubectl delete TYPE NAME --grace-period=0 --force

Examples:
  fucking die api-7d9f8b6c9d-j2k4m
  fucking nope pod api-7d9f8b6c9d-j2k4m
  fucking nope deployment api
  fucking nope deployments.apps api

Notes:
  Uses your active kubectl context and namespace.
  Try "please stop" or "please nope" first when normal deletion is enough.
EOF
}

if [ $# -lt 1 ]; then
  usage
  exit 1
fi

command="$1"
shift

case "$command" in
  die)
    if [ $# -ne 1 ]; then
      echo "Usage: fucking die POD" >&2
      exit 1
    fi

    kubectl delete pod "$1" --grace-period=0 --force
    ;;
  nope)
    if [ $# -ne 2 ]; then
      echo "Usage: fucking nope TYPE NAME" >&2
      exit 1
    fi

    kubectl delete "$1" "$2" --grace-period=0 --force
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown fucking command: $command" >&2
    usage
    exit 1
    ;;
esac
