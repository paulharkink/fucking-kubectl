#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
please: polite Kubernetes shortcuts for the current namespace.

Usage:
  please [KUBECTL_FLAGS] COMMAND ...
  please stop POD
  please nope TYPE NAME
  please restart DEPLOYMENT
  please why POD
  please sherlock POD
  please invade POD [CONTAINER]
  please show POD [CONTAINER] [--all]
  please follow POD [CONTAINER]

Options:
  -h, --help  Show this help.

Kubectl flags:
  -n, --namespace NAME  Use a namespace for this command.
      --context NAME    Use a kubeconfig context for this command.
      --kubeconfig PATH Use a kubeconfig file for this command.

Commands:
  stop     Delete a pod normally.
           Runs: kubectl delete pod POD

  nope     Delete any namespaced resource normally.
           Runs: kubectl delete TYPE NAME

  restart  Roll out a deployment restart.
           Runs: kubectl rollout restart deployment DEPLOYMENT

  why      Inspect why a pod died or is unhealthy.
           Shows pod status, related events, and previous logs.

  sherlock Alias for "why".

  invade   Open an interactive shell in a pod.
           Tries zsh, then bash, then falls back to sh.

  show     Show recent pod logs, with readable JSON log formatting when possible.
           Runs: kubectl logs --tail=200 POD

  follow   Follow pod logs, with readable JSON log formatting when possible.
           Runs: kubectl logs -f POD

Examples:
  please stop api-7d9f8b6c9d-j2k4m
  please nope deployment api
  please nope deployments.apps api
  please restart api
  please why api-7d9f8b6c9d-j2k4m
  please sherlock api-7d9f8b6c9d-j2k4m
  please invade api-7d9f8b6c9d-j2k4m
  please invade api-7d9f8b6c9d-j2k4m app
  please show api-7d9f8b6c9d-j2k4m
  please show api-7d9f8b6c9d-j2k4m app --all
  please follow api-7d9f8b6c9d-j2k4m app

Notes:
  Uses your active kubectl context and namespace.
  Use "fucking" for the same delete intent with --grace-period=0 --force.
EOF
}

if [ $# -lt 1 ]; then
  usage
  exit 1
fi

kubectl_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--namespace|--context|--kubeconfig)
      if [ $# -lt 2 ]; then
        echo "Missing value for $1" >&2
        exit 1
      fi
      kubectl_args+=("$1" "$2")
      shift 2
      ;;
    --namespace=*|--context=*|--kubeconfig=*)
      kubectl_args+=("$1")
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      break
      ;;
    *)
      break
      ;;
  esac
done

if [ $# -lt 1 ]; then
  usage
  exit 1
fi

command="$1"
shift

section() {
  printf '\n== %s ==\n' "$1"
}

k() {
  if [ "${#kubectl_args[@]}" -gt 0 ]; then
    kubectl "${kubectl_args[@]}" "$@"
  else
    kubectl "$@"
  fi
}

pretty_logs() {
  if ! command -v jq >/dev/null 2>&1; then
    cat "$@"
    return
  fi

  jq -Rr '
    def esc: "\u001b[";
    def reset: esc + "0m";
    def dim($value): esc + "2m" + ($value | tostring) + reset;
    def cyan($value): esc + "36m" + ($value | tostring) + reset;
    def red($value): esc + "31m" + ($value | tostring) + reset;
    def yellow($value): esc + "33m" + ($value | tostring) + reset;
    def green($value): esc + "32m" + ($value | tostring) + reset;
    def gray($value): esc + "90m" + ($value | tostring) + reset;
    def faint($value): esc + "38;5;244m" + ($value | tostring) + reset;

    def message_fields:
      [
        "message",
        "msg",
        "body",
        "Body",
        "text",
        "error.message",
        "exception.message",
        "err.message",
        "error",
        "event.original",
        "log.original",
        "log"
      ];

    def stack_fields:
      [
        "stack_trace",
        "stacktrace",
        "stack",
        "error.stack_trace",
        "exception.stacktrace",
        "exception.stack",
        "exception.StackTrace",
        "err.stack",
        "error.stack",
        "Exception",
        "@x"
      ];

    def value_at($name):
      . as $object
      | if ($object | has($name)) and $object[$name] != null then
          $object[$name]
        else
          try ($object | getpath($name | split("."))) catch null
        end;

    def has_field($names):
      . as $object
      | reduce $names[] as $name (
          false;
          . or (($object | value_at($name)) != null)
        );

    def has_log_shape:
      type == "object"
      and (
        has_field(message_fields) or has_field(stack_fields)
        or has("level") or has("severity")
        or has("@timestamp") or has("timestamp")
        or has("logger_name") or has("logger")
      );

    def field($names):
      . as $object
      | reduce $names[] as $name (
          null;
          if . == null and ($object | value_at($name)) != null
          then ($object | value_at($name))
          else .
          end
        ) // "";

    def stringify_field:
      if type == "array" then
        map(tostring) | join("\n")
      elif type == "object" then
        tojson
      else
        tostring
      end;

    def logger:
      (field(["logger_name", "logger", "loggerName"]) | tostring)
      | if length > 0 then split(".") | last else "" end;

    def color_level:
      . as $level
      | ($level | tostring | ascii_upcase) as $upper
      | if $upper == "" then ""
        elif ["ERROR", "ERR", "FATAL", "CRITICAL"] | index($upper) then red($level)
        elif ["WARN", "WARNING"] | index($upper) then yellow($level)
        elif ["INFO", "NOTICE"] | index($upper) then green($level)
        elif $upper == "DEBUG" then cyan($level)
        elif $upper == "TRACE" then gray($level)
        else $level
        end;

    def color_plaintext:
      . as $line
      | if test("^[[:space:]]*(ERROR|ERR|FATAL|CRITICAL|WARN|WARNING|INFO|NOTICE|DEBUG|TRACE)\\b") then
          sub("^(?<prefix>[[:space:]]*)(?<level>ERROR|ERR|FATAL|CRITICAL|WARN|WARNING|INFO|NOTICE|DEBUG|TRACE)\\b"; "\(.prefix)\(.level | color_level)")
        elif test("^[[:space:]]*\\[(ERROR|ERR|FATAL|CRITICAL|WARN|WARNING|INFO|NOTICE|DEBUG|TRACE)\\]") then
          sub("^(?<prefix>[[:space:]]*)\\[(?<level>ERROR|ERR|FATAL|CRITICAL|WARN|WARNING|INFO|NOTICE|DEBUG|TRACE)\\]"; "\(.prefix)[\(.level | color_level)]")
        elif test("^[[:space:]]*(time|timestamp|ts)=") and test("\\blevel=\"?(ERROR|ERR|FATAL|CRITICAL|WARN|WARNING|INFO|NOTICE|DEBUG|TRACE)\"?\\b") then
          sub("^(?<prefix>[[:space:]]*(?:time|timestamp|ts)=\"?[^[:space:]\"]+\"?)"; "\(dim(.prefix))")
          | sub("\\blevel=\"?(?<level>ERROR|ERR|FATAL|CRITICAL|WARN|WARNING|INFO|NOTICE|DEBUG|TRACE)\"?"; "level=\(.level | color_level)")
        elif test("^[[:space:]]*[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][^[:space:]]+[[:space:]]+(ERROR|ERR|FATAL|CRITICAL|WARN|WARNING|INFO|NOTICE|DEBUG|TRACE)\\b") then
          sub("^(?<prefix>[[:space:]]*)(?<timestamp>[0-9]{4}-[0-9]{2}-[0-9]{2}[T ][^[:space:]]+)(?<space>[[:space:]]+)(?<level>ERROR|ERR|FATAL|CRITICAL|WARN|WARNING|INFO|NOTICE|DEBUG|TRACE)\\b"; "\(.prefix)\(dim(.timestamp))\(.space)\(.level | color_level)")
        else
          faint($line)
        end;

    def format_log:
      [
        (field(["@timestamp", "timestamp", "time", "ts"]) | stringify_field | if length > 0 then dim(.) else "" end),
        (field(["level", "severity"]) | stringify_field | color_level),
        (field(["thread_name", "thread"]) | stringify_field),
        (logger | if length > 0 then cyan(.) else "" end),
        (field(message_fields) | stringify_field)
      ] as $parts
      | (field(stack_fields) | stringify_field) as $stack
      | ($parts | map(select(length > 0)) | join("  ")) as $line
      | if $stack | length > 0 then
          $line + "\n" + gray($stack)
        else
          $line
        end;

    . as $raw
    | try (fromjson | if has_log_shape then format_log else ($raw | color_plaintext) end) catch ($raw | color_plaintext)
  ' "$@"
}

parse_args() {
  positionals=()

  while [ $# -gt 0 ]; do
    case "$1" in
      --)
        shift
        while [ $# -gt 0 ]; do
          positionals+=("$1")
          shift
        done
        ;;
      -*)
        echo "Unknown option after command: $1" >&2
        echo "Put kubectl flags before the command, for example: please -n namespace stop POD" >&2
        exit 1
        ;;
      *)
        positionals+=("$1")
        shift
        ;;
    esac
  done
}

case "$command" in
  stop|die)
    parse_args "$@"
    if [ "${#positionals[@]}" -ne 1 ]; then
      echo "Usage: please stop POD" >&2
      exit 1
    fi

    k delete pod "${positionals[0]}"
    ;;
  nope)
    parse_args "$@"
    if [ "${#positionals[@]}" -ne 2 ]; then
      echo "Usage: please nope TYPE NAME" >&2
      exit 1
    fi

    k delete "${positionals[0]}" "${positionals[1]}"
    ;;
  restart)
    parse_args "$@"
    if [ "${#positionals[@]}" -ne 1 ]; then
      echo "Usage: please restart DEPLOYMENT" >&2
      exit 1
    fi

    k rollout restart deployment "${positionals[0]}"
    ;;
  why|sherlock)
    parse_args "$@"
    if [ "${#positionals[@]}" -ne 1 ]; then
      echo "Usage: please why POD" >&2
      exit 1
    fi

    pod="${positionals[0]}"

    section "Pod"
    k get pod "$pod" -o wide

    section "Events"
    k get events --field-selector "involvedObject.name=$pod" --sort-by=.lastTimestamp

    section "Previous Logs"
    k logs "$pod" --previous --tail=200 | pretty_logs
    ;;
  pretty)
    pretty_logs "$@"
    ;;
  show|follow)
    positionals=()
    all_logs=false

    while [ $# -gt 0 ]; do
      case "$1" in
        --all)
          if [ "$command" != "show" ]; then
            echo "Unknown option after command: $1" >&2
            exit 1
          fi
          if [ "${#positionals[@]}" -lt 1 ]; then
            echo "Usage: please show POD [CONTAINER] [--all]" >&2
            exit 1
          fi
          all_logs=true
          shift
          ;;
        --)
          shift
          while [ $# -gt 0 ]; do
            positionals+=("$1")
            shift
          done
          ;;
        -*)
          echo "Unknown option after command: $1" >&2
          echo "Put kubectl flags before the command, for example: please -n namespace $command POD" >&2
          exit 1
          ;;
        *)
          if [ "$all_logs" = true ]; then
            echo "Usage: please show POD [CONTAINER] [--all]" >&2
            exit 1
          fi
          positionals+=("$1")
          shift
          ;;
      esac
    done

    if [ "${#positionals[@]}" -lt 1 ] || [ "${#positionals[@]}" -gt 2 ]; then
      if [ "$command" = "show" ]; then
        echo "Usage: please show POD [CONTAINER] [--all]" >&2
      else
        echo "Usage: please follow POD [CONTAINER]" >&2
      fi
      exit 1
    fi

    pod="${positionals[0]}"
    container="${positionals[1]:-}"
    log_args=(logs)

    if [ "$command" = "follow" ]; then
      log_args+=(-f)
    elif [ "$all_logs" != true ]; then
      log_args+=(--tail=200)
    fi

    log_args+=("$pod")

    if [ -n "$container" ]; then
      log_args+=(-c "$container")
    fi

    k "${log_args[@]}" | pretty_logs
    ;;
  invade)
    parse_args "$@"
    if [ "${#positionals[@]}" -lt 1 ] || [ "${#positionals[@]}" -gt 2 ]; then
      echo "Usage: please invade POD [CONTAINER]" >&2
      exit 1
    fi

    pod="${positionals[0]}"
    container="${positionals[1]:-}"

    probe_args=(exec "$pod")
    interactive_args=(exec -it "$pod")

    if [ "${#kubectl_args[@]}" -gt 0 ]; then
      probe_args=("${kubectl_args[@]}" "${probe_args[@]}")
      interactive_args=("${kubectl_args[@]}" "${interactive_args[@]}")
    fi

    if [ -n "$container" ]; then
      probe_args+=(-c "$container")
      interactive_args+=(-c "$container")
    fi

    shell="sh"
    for candidate in zsh bash; do
      if kubectl "${probe_args[@]}" -- sh -c "command -v '$candidate'" >/dev/null 2>&1; then
        shell="$candidate"
        break
      fi
    done

    kubectl "${interactive_args[@]}" -- "$shell"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown please command: $command" >&2
    usage
    exit 1
    ;;
esac
