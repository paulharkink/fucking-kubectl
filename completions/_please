#compdef please

local curcontext="$curcontext" state
typeset -A opt_args

if [[ "${words[2]}" == "invade" ]]; then
  case $CURRENT in
    3)
      local -a pods
      pods=(${(f)"$(kubectl get pods --no-headers -o custom-columns=:metadata.name 2>/dev/null)"})
      compadd -a pods
      return 0
      ;;
    4)
      local -a containers
      containers=(${(f)"$(kubectl get pod "${words[3]}" -o 'jsonpath={range .spec.containers[*]}{.name}{"\n"}{end}' 2>/dev/null)"})
      compadd -a containers
      return 0
      ;;
    *)
      return 0
      ;;
  esac
fi

_arguments -C \
  '(-h --help)'{-h,--help}'[show help]' \
  '1:command:->commands' \
  '2:resource type, pod, or deployment:->resource_or_target' \
  '3:resource name or container:->resource_names_or_containers' \
  '*:: :->rest'

case $state in
  commands)
    local -a commands
    commands=(
      'stop:delete a pod in the current Kubernetes namespace'
      'nope:delete a resource in the current Kubernetes namespace'
      'restart:roll out a deployment restart in the current Kubernetes namespace'
      'why:inspect why a pod died or is unhealthy'
      'sherlock:alias for why'
      'invade:open an interactive shell in a pod'
      'help:show help'
    )
    _describe 'commands' commands
    ;;
  resource_or_target)
    case "${words[2]}" in
      stop|die|why|sherlock|invade)
        local -a pods
        pods=(${(f)"$(kubectl get pods --no-headers -o custom-columns=:metadata.name 2>/dev/null)"})
        _describe 'pods' pods
        ;;
      restart)
        local -a deployments
        deployments=(${(f)"$(kubectl get deployments --no-headers -o custom-columns=:metadata.name 2>/dev/null)"})
        _describe 'deployments' deployments
        ;;
      nope)
        local -a resource_types
        resource_types=(${(f)"$(kubectl api-resources --verbs=delete --namespaced=true -o name 2>/dev/null)"})
        _describe 'resource types' resource_types
        ;;
    esac
    ;;
  resource_names_or_containers)
    if [[ "${words[2]}" == "nope" && -n "${words[3]}" ]]; then
      local -a resources
      resources=(${(f)"$(kubectl get "${words[3]}" --no-headers -o custom-columns=:metadata.name 2>/dev/null)"})
      _describe "${words[3]}" resources
    fi
    ;;
esac

return 0
