#compdef please

local -a kubectl_args command_specs global_options positionals
local command="" command_index=$CURRENT arg_position

command_specs=(
  'stop:delete a pod in the current Kubernetes namespace'
  'nope:delete a resource in the current Kubernetes namespace'
  'restart:roll out a deployment restart in the current Kubernetes namespace'
  'why:inspect why a pod died or is unhealthy'
  'sherlock:alias for why'
  'invade:open an interactive shell in a pod'
  'help:show help'
)

global_options=(
  '-n[use a namespace]'
  '--namespace[use a namespace]'
  '--context[use a kubeconfig context]'
  '--kubeconfig[use a kubeconfig file]'
  '-h[show help]'
  '--help[show help]'
)

local i=2
while (( i < CURRENT )); do
  case "${words[i]}" in
    -n|--namespace|--context|--kubeconfig)
      if (( i + 1 < CURRENT )); then
        kubectl_args+=("${words[i]}" "${words[$(( i + 1 ))]}")
        (( i += 2 ))
      else
        break
      fi
      ;;
    --namespace=*|--context=*|--kubeconfig=*)
      kubectl_args+=("${words[i]}")
      (( i++ ))
      ;;
    --)
      (( i++ ))
      break
      ;;
    -*)
      (( i++ ))
      ;;
    *)
      command="${words[i]}"
      command_index=$i
      break
      ;;
  esac
done

if [[ "${words[CURRENT-1]}" == "-n" || "${words[CURRENT-1]}" == "--namespace" ]]; then
  local -a namespaces
  namespaces=(${(f)"$(kubectl "${kubectl_args[@]}" get namespaces --no-headers -o custom-columns=:metadata.name 2>/dev/null)"})
  compadd -a namespaces
  return 0
fi

if [[ "${words[CURRENT-1]}" == "--context" ]]; then
  local -a contexts
  contexts=(${(f)"$(kubectl config get-contexts -o name 2>/dev/null)"})
  compadd -a contexts
  return 0
fi

if [[ "${words[CURRENT-1]}" == "--kubeconfig" ]]; then
  _files
  return 0
fi

if [[ -z "$command" || $CURRENT -eq $command_index ]]; then
  if [[ "${words[CURRENT]}" == -* ]]; then
    _describe 'options' global_options
  else
    _describe 'commands' command_specs
  fi
  return 0
fi

if [[ "${words[CURRENT]}" == -* ]]; then
  _describe 'options' global_options
  return 0
fi

i=$(( command_index + 1 ))
while (( i < CURRENT )); do
  case "${words[i]}" in
    -n|--namespace|--context|--kubeconfig)
      if (( i + 1 < CURRENT )); then
        kubectl_args+=("${words[i]}" "${words[$(( i + 1 ))]}")
        (( i += 2 ))
      else
        break
      fi
      ;;
    --namespace=*|--context=*|--kubeconfig=*)
      kubectl_args+=("${words[i]}")
      (( i++ ))
      ;;
    --)
      (( i++ ))
      ;;
    -*)
      (( i++ ))
      ;;
    *)
      positionals+=("${words[i]}")
      (( i++ ))
      ;;
  esac
done

arg_position=$(( ${#positionals[@]} + 1 ))

case "$command" in
  stop|die|why|sherlock)
    if (( arg_position == 1 )); then
      local -a pods
      pods=(${(f)"$(kubectl "${kubectl_args[@]}" get pods --no-headers -o custom-columns=:metadata.name 2>/dev/null)"})
      compadd -a pods
    fi
    ;;
  restart)
    if (( arg_position == 1 )); then
      local -a deployments
      deployments=(${(f)"$(kubectl "${kubectl_args[@]}" get deployments --no-headers -o custom-columns=:metadata.name 2>/dev/null)"})
      compadd -a deployments
    fi
    ;;
  nope)
    if (( arg_position == 1 )); then
      local -a resource_types
      resource_types=(${(f)"$(kubectl "${kubectl_args[@]}" api-resources --verbs=delete --namespaced=true -o name 2>/dev/null)"})
      compadd -a resource_types
    elif (( arg_position == 2 )); then
      local -a resources
      resources=(${(f)"$(kubectl "${kubectl_args[@]}" get "${positionals[1]}" --no-headers -o custom-columns=:metadata.name 2>/dev/null)"})
      compadd -a resources
    fi
    ;;
  invade)
    if (( arg_position == 1 )); then
      local -a pods
      pods=(${(f)"$(kubectl "${kubectl_args[@]}" get pods --no-headers -o custom-columns=:metadata.name 2>/dev/null)"})
      compadd -a pods
    elif (( arg_position == 2 )); then
      local -a containers
      containers=(${(f)"$(kubectl "${kubectl_args[@]}" get pod "${positionals[1]}" -o 'jsonpath={range .spec.containers[*]}{.name}{"\n"}{end}' 2>/dev/null)"})
      compadd -a containers
    fi
    ;;
esac

return 0
